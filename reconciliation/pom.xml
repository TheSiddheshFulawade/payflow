<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.siddheshfulawade.payflow</groupId>
    <artifactId>payflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>reconciliation</artifactId>
  <name>PayFlow · reconciliation</name>
  <description>End-of-day Spring Batch job: download statements, stage, match, report mismatches.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <!-- Boot 4: the Batch job repository in a database (JDBC) is its own starter; it brings spring-boot-starter-jdbc. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Boot 4: Flyway is only auto-configured through spring-boot-flyway (this starter), not flyway-core alone. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <!-- runtime: Flyway loads the PostgreSQL support through ServiceLoader; no code compiles against it -->
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <!-- The job's SQL and wiring are covered by the Testcontainers tests (tag "it"), which the default build does not
         run; the coverage gate therefore runs only with -Pit (same as payment-service and wallet-service). -->
    <jacoco.skip>true</jacoco.skip>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>it</id>
      <properties>
        <jacoco.skip>false</jacoco.skip>
      </properties>
    </profile>
  </profiles>
</project>
